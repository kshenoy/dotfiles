{
  "theme": "custom:catppuccin-mocha",
  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "Bash(awk:*)",
      "Bash(command:*)",
      "Bash(dig *)",
      "Bash(getent *)",
      "Bash(git branch:*)",
      "Bash(git describe:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git stash list:*)",
      "Bash(git tag:*)",
      "Bash(git worktree list:*)",
      "Bash(jq:*)",
      "Bash(npm info:*)",
      "Bash(npm list:*)",
      "Bash(npm outdated:*)",
      "Bash(openssl s_client *)",
      "Bash(pip list:*)",
      "Bash(pip show:*)",
      "Bash(python3 -m json.tool)",
      "Bash(rg:*)",
      "Edit(**/.claude/CLAUDE.md)",
      "Edit(~/.config/dotfiles*/**)",
      "Read",
      "WebFetch",
      "WebSearch"
    ]
  },
  "agentPushNotifEnabled": true,
  "//autoMemoryEnabled": "Off: memory is machine-local and unreviewed; durable rules live in version-controlled CLAUDE.md files instead",
  "autoMemoryEnabled": false
}
