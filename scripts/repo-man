#!/usr/bin/env bash
# Sync one or more git repos: stash local changes, pull --rebase, push if ahead, then unstash.
# Never adds or commits — a repo's own edits are committed explicitly by whoever made them.
#
# Safety net for the HomeLab/Coppermind two-branch vault-sync model: also tries a plain (non-forcing)
# `push main:livesync` on any repo with an `origin/livesync` ref, in case a Claude session committed on
# `main` without following through on its own push-both-branches step. Harmless no-op if already pushed;
# rejected (and ignored) if `livesync` has since diverged — never merges/rebases it, so it can't ship a
# conflicted tree. Real reconciliation of a diverged `livesync` stays a supervised, in-session step.
#
# Run with -h/--help for usage.

set -uo pipefail

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

print_help() {
  cat <<EOF
Usage: $(basename "$0") <repo> [<repo> ...]

For each repo: stash local changes (if any), pull --rebase, push if ahead, then unstash. Also tries a plain
push of main:livesync where an origin/livesync ref exists (see header comment).

Example:
  $(basename "$0") ~/HomeLab ~/Coppermind
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) print_help; exit 0 ;;
    --)        shift; break ;;
    -*)        echo "Unknown option: $1" >&2; exit 1 ;;
    *)         break ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "Usage: $(basename "$0") <repo> [<repo> ...]" >&2
  exit 1
fi

first=true
for dir in "$@"; do
  dir="${dir%/}"

  if $first; then first=false; else echo; fi

  # -e, not -d: a linked worktree's .git is a file (`gitdir: ...`), not a directory
  if [[ ! -e "$dir/.git" ]]; then
    log "==> $dir (missing, skipping)"
    continue
  fi

  log "==> $dir"

  # Subshell: keeps `cd` from leaking into the next iteration (so relative paths in
  # later args still resolve against the original cwd), and its EXIT trap guarantees
  # the stash pop runs on every exit path — normal, early `exit`, or interrupted —
  # instead of relying on unstash being explicitly reached in each branch.
  (
    cd "$dir" || exit 1

    local_changes=false
    restore() {
      if $local_changes; then
        log "  Unstashing"
        git stash pop || log "  Unstash failed — resolve manually in $dir"
      fi
    }
    trap restore EXIT

    if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
      log "  Stashing"
      if ! git stash; then
        log "  Stash failed — skipping"
        exit 0
      fi
      local_changes=true
    fi

    log "  Pulling (rebase)"
    if ! git pull --rebase; then
      log "  Pull failed — aborting rebase"
      git rebase --abort 2>/dev/null
      exit 0
    fi

    ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
    if [[ "$ahead" -gt 0 ]]; then
      log "  Pushing"
      git push || log "  Push failed — resolve manually in $dir"
    fi

    # Vault-sync safety net (see header comment) — only applies where a livesync branch exists.
    if git show-ref --verify --quiet refs/remotes/origin/livesync; then
      if git push origin main:livesync 2>/dev/null; then
        log "  Fast-forwarded livesync"
      fi
    fi
  )
done
