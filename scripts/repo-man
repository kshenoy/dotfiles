#!/usr/bin/env bash
# Sync one or more git repos. Run with -h/--help for usage.

set -uo pipefail

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"; }

print_help() {
  cat <<EOF
Usage: $(basename "$0") [--commit] <repo> [<repo> ...]

Sync one or more git repos: by default, stash local changes, pull --rebase, push if ahead,
then unstash.

--commit    Commit local changes instead of stashing them, for repos where nothing is ever
            "in progress" (everything sitting in the working tree is meant to be captured
            permanently, e.g. edits arriving from an external sync process) — so there's
            nothing to preserve via stash/unstash, and no reason to risk a stash-pop conflict.
            Applies to every repo in this invocation; run separately for a mix of repos that
            need different treatment.

Examples:
  $(basename "$0") ~/HomeLab ~/Coppermind
  $(basename "$0") --commit /mnt/store/Obsidian-Headless/Vaults/HomeLab
EOF
}

action=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_help
      exit 0
      ;;
    --commit)
      action="commit"
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "Usage: $(basename "$0") [--commit] <repo> [<repo> ...]" >&2
  exit 1
fi

first=true
for dir in "$@"; do
  dir="${dir%/}"

  if $first; then
    first=false
  else
    echo
  fi

  # -e, not -d: a linked worktree's .git is a file (`gitdir: ...`), not a directory
  if [[ ! -e "$dir/.git" ]]; then
    log "==> $dir (missing, skipping)"
    continue
  fi

  log "==> $dir"

  # Subshell: keeps `cd` from leaking into the next iteration (so relative paths in
  # later args still resolve against the original cwd), and its EXIT trap guarantees
  # the stash pop runs on every exit path — normal, early `exit`, or interrupted —
  # instead of relying on unstash being explicitly reached in each branch.
  (
    cd "$dir" || exit 1

    if [[ "$action" == "commit" ]]; then
      git add -A
      if ! git diff --cached --quiet; then
        log "  Committing local changes"
        git commit -m "Auto-commit from repo-man ($(date '+%Y-%m-%d %H:%M %Z'))" --quiet
      fi
    else
      local_changes=false
      restore() {
        if $local_changes; then
          log "  Unstashing"
          git stash pop || log "  Unstash failed — resolve manually in $dir"
        fi
      }
      trap restore EXIT

      if [[ -n "$(git status --porcelain --untracked-files=no)" ]]; then
        log "  Stashing"
        if ! git stash; then
          log "  Stash failed — skipping"
          exit 0
        fi
        local_changes=true
      fi
    fi

    log "  Pulling (rebase)"
    if ! git pull --rebase; then
      log "  Pull failed — aborting rebase"
      git rebase --abort 2>/dev/null
      exit 0
    fi

    ahead=$(git rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
    if [[ "$ahead" -gt 0 ]]; then
      log "  Pushing"
      git push || log "  Push failed — resolve manually in $dir"
    fi
  )
done
